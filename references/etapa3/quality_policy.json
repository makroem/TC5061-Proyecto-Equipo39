  "reviewers": {
    "p1": "Stefania",
    "p2": "Diego Martinez",
    "p3": "Diego Hurtado"
  },
  "seed": 39,
  "deepchecks_sample_rows": 100000,
  "lineage": [
    {"id": "version_de_datos", "check": "data_version", "severity": "critical",
     "reason": "Las tablas deben venir de la misma data_version que los manifiestos confirmados."},
    {"id": "tablas_alineadas", "check": "aligned_tables", "severity": "critical",
     "reason": "metadata, X, y_p1 y y_p2 se leen fila por fila; un desfase mezcla objetivos."},
    {"id": "particion_del_manifiesto", "check": "split_days", "severity": "critical",
     "reason": "Cada fila debe caer en el conjunto que fija split_manifest.json, sin recalcular la partición."},
    {"id": "salidas_del_manifiesto", "check": "manifest_outputs", "severity": "critical",
     "reason": "Los Parquet de viajes, llegadas, salidas y estaciones deben coincidir en filas y hash lógico."}
  ],
  "questions": {
    "p1": {
      "label": "target_departures",
      "label_type": "regression",
      "features": ["station_id", "hour_of_day", "day_of_week", "month", "is_weekend",
                   "hour_sin", "hour_cos", "month_sin", "month_cos"],
      "cat_features": ["station_id"],
      "key": ["station_id", "prediction_time"],
      "checks": [
        {"id": "variables_del_modelo", "check": "columns", "severity": "critical",
         "params": {"exact": ["hour_of_day", "day_of_week", "month", "is_weekend",
                              "hour_sin", "hour_cos", "month_sin", "month_cos"]},
         "reason": "X solo lleva calendario; cualquier columna extra puede filtrar el objetivo."},
        {"id": "sin_nulos", "check": "nulls", "severity": "critical",
         "reason": "El modelo no imputa valores."},
        {"id": "llave_unica", "check": "unique_key", "severity": "critical",
         "reason": "Una estación-hora repetida duplica el objetivo."},
        {"id": "dominios", "check": "domain", "severity": "critical",
         "params": {"ranges": {"hour_of_day": [0, 23], "day_of_week": [0, 6], "month": [1, 12],
                               "is_weekend": [0, 1], "hour_sin": [-1, 1], "hour_cos": [-1, 1],
                               "month_sin": [-1, 1], "month_cos": [-1, 1],
                               "target_departures": [0, null]},
                    "integer": ["hour_of_day", "day_of_week", "month", "is_weekend",
                                "target_departures"]},
         "reason": "Rangos del calendario y conteos de salidas no negativos y enteros."},
        {"id": "malla_completa", "check": "complete_grid", "severity": "critical",
         "reason": "Las horas sin viajes deben existir como cero; si faltan, el MAE se calcula sobre otra población."},
        {"id": "estaciones_elegibles", "check": "min_entities", "severity": "critical",
         "params": {"min": 1}, "reason": "La regla de 100 salidas en train debe dejar estaciones."},
        {"id": "variable_constante", "deepchecks": "IsSingleValue", "mode": "single",
         "condition": "add_condition_not_single_value", "severity": "critical",
         "reason": "Una variable constante en un conjunto no aporta información."},
        {"id": "tipos_mezclados", "deepchecks": "MixedDataTypes", "mode": "single",
         "condition": "add_condition_rare_type_ratio_not_in_range", "severity": "critical",
         "reason": "Cada columna debe tener un solo tipo."},
        {"id": "correlacion_con_objetivo", "deepchecks": "FeatureLabelCorrelation", "mode": "single",
         "condition": "add_condition_feature_pps_less_than", "params": {"threshold": 0.8},
         "severity": "warning",
         "reason": "Un PPS alto puede indicar fuga; con solo calendario se espera bajo."},
        {"id": "mezcla_entre_conjuntos", "deepchecks": "TrainTestSamplesMix", "mode": "pair",
         "condition": "add_condition_duplicates_ratio_less_or_equal", "params": {"max_ratio": 0.0},
         "severity": "critical",
         "reason": "Ninguna muestra de validación o prueba puede repetirse en train."},
        {"id": "deriva_de_variables", "deepchecks": "FeatureDrift", "mode": "pair",
         "init": {"ignore_columns": ["month", "month_sin", "month_cos"]},
         "condition": "add_condition_drift_score_less_than", "severity": "warning",
         "reason": "Se reporta para interpretar. Los meses se excluyen porque la partición cronológica los separa por diseño."},
        {"id": "deriva_del_objetivo", "deepchecks": "LabelDrift", "mode": "pair",
         "condition": "add_condition_drift_score_less_than", "severity": "warning",
         "reason": "El cambio estacional de la demanda no es por sí solo un defecto de datos."},
        {"id": "estaciones_nuevas", "deepchecks": "NewCategoryTrainTest", "mode": "pair",
         "init": {"columns": ["station_id"]},
         "condition": "add_condition_new_categories_less_or_equal", "params": {"max_new": 0},
         "severity": "warning",
         "reason": "Una estación sin historia en train recibe la media global del modelo."}
      ]
    },
    "p2": {
      "labels": ["y_bikes", "y_docks"],
      "label_type": "binary",
      "features": ["station_id", "hour_of_day", "day_of_week", "month", "is_weekend",
                   "hour_sin", "hour_cos", "month_sin", "month_cos"],
      "cat_features": ["station_id"],
      "key": ["station_id", "prediction_time"],
      "checks": [
        {"id": "variables_del_modelo", "check": "columns", "severity": "critical",
         "params": {"exact": ["hour_of_day", "day_of_week", "month", "is_weekend",
                              "hour_sin", "hour_cos", "month_sin", "month_cos"]},
         "reason": "capacity, flow_min y flow_max solo definen la etiqueta y no pueden entrar a X."},
        {"id": "sin_nulos", "check": "nulls", "severity": "critical",
         "reason": "Las filas sin capacidad válida se excluyen antes; lo demás no puede tener nulos."},
        {"id": "llave_unica", "check": "unique_key", "severity": "critical",
         "reason": "Una estación-hora repetida duplica la etiqueta."},
        {"id": "dominios", "check": "domain", "severity": "critical",
         "params": {"ranges": {"hour_of_day": [0, 23], "day_of_week": [0, 6], "month": [1, 12],
                               "is_weekend": [0, 1], "hour_sin": [-1, 1], "hour_cos": [-1, 1],
                               "month_sin": [-1, 1], "month_cos": [-1, 1],
                               "y_bikes": [0, 1], "y_docks": [0, 1], "capacity": [1, null]},
                    "integer": ["y_bikes", "y_docks", "capacity"]},
         "reason": "Etiquetas binarias y capacidad positiva entera."},
        {"id": "etiqueta_reproducible", "check": "p2_labels", "severity": "critical",
         "reason": "y_bikes y y_docks deben salir de proxy_labels con capacidad, flujos y ocupación de 50%."},
        {"id": "malla_completa", "check": "complete_grid", "severity": "critical",
         "reason": "Las horas sin flujo cuentan como estación-horas sin riesgo."},
        {"id": "positivos_por_riesgo", "check": "min_positives", "severity": "critical",
         "params": {"min": 100},
         "reason": "Con menos de 100 positivos el umbral de recall 0.80 queda mal estimado y la métrica no es evaluable."},
        {"id": "variable_constante", "deepchecks": "IsSingleValue", "mode": "single",
         "condition": "add_condition_not_single_value", "severity": "critical",
         "reason": "Una variable constante en un conjunto no aporta información."},
        {"id": "tipos_mezclados", "deepchecks": "MixedDataTypes", "mode": "single",
         "condition": "add_condition_rare_type_ratio_not_in_range", "severity": "critical",
         "reason": "Cada columna debe tener un solo tipo."},
        {"id": "correlacion_con_objetivo", "deepchecks": "FeatureLabelCorrelation", "mode": "single",
         "condition": "add_condition_feature_pps_less_than", "params": {"threshold": 0.8},
         "severity": "warning",
         "reason": "Un PPS alto con solo calendario y estación indicaría fuga de la etiqueta."},
        {"id": "mezcla_entre_conjuntos", "deepchecks": "TrainTestSamplesMix", "mode": "pair",
         "condition": "add_condition_duplicates_ratio_less_or_equal", "params": {"max_ratio": 0.0},
         "severity": "critical",
         "reason": "Ninguna muestra de validación o prueba puede repetirse en train."},
        {"id": "deriva_de_variables", "deepchecks": "FeatureDrift", "mode": "pair",
         "init": {"ignore_columns": ["month", "month_sin", "month_cos"]},
         "condition": "add_condition_drift_score_less_than", "severity": "warning",
         "reason": "Se reporta para interpretar. Los meses se excluyen porque la partición cronológica los separa por diseño."},
        {"id": "prevalencia_por_riesgo", "check": "prevalence_ratio", "mode": "pair",
         "params": {"range": [0.5, 2.0]}, "severity": "warning",
         "reason": "LabelDrift usa V de Cramér, que casi no reacciona con etiquetas raras: una prevalencia diez veces mayor da 0.12 y pasa. Se compara la prevalencia contra train; fuera de 0.5 a 2 veces cambian la precisión y la carga de alertas aunque el umbral quede fijo."},
        {"id": "estaciones_nuevas", "deepchecks": "NewCategoryTrainTest", "mode": "pair",
         "init": {"columns": ["station_id"]},
         "condition": "add_condition_new_categories_less_or_equal", "params": {"max_new": 0},
         "severity": "warning",
         "reason": "Una estación sin historia en train recibe solo el efecto del calendario."}
      ]
    },
    "p3": {
      "label": null,
      "features": "profile",
      "key": ["station_id"],
      "checks": [
        {"id": "perfil_de_48_horas", "check": "columns", "severity": "critical",
         "params": {"prefixes": ["weekday_hour_", "weekend_hour_"], "count": 48},
         "reason": "El perfil son 24 proporciones de día laboral y 24 de fin de semana."},
        {"id": "sin_nulos", "check": "nulls", "severity": "critical",
         "reason": "GMM y KMeans no aceptan nulos."},
        {"id": "llave_unica", "check": "unique_key", "severity": "critical",
         "reason": "Cada estación aparece una vez por conjunto."},
        {"id": "proporciones", "check": "profile_sums", "severity": "critical",
         "params": {"tolerance": 1e-6},
         "reason": "Cada bloque de 24 horas suma uno, o cero si la estación no tuvo viajes en ese tipo de día."},
        {"id": "estaciones_suficientes", "check": "min_entities", "severity": "critical",
         "params": {"min": 4}, "reason": "Se necesitan más estaciones que los 3 grupos de P3."},
        {"id": "variable_constante", "deepchecks": "IsSingleValue", "mode": "single",
         "condition": "add_condition_not_single_value", "severity": "warning",
         "reason": "Horas de madrugada sin viajes en ninguna estación dan columnas en cero; se reportan, no invalidan el perfil."},
        {"id": "perfiles_duplicados", "deepchecks": "DataDuplicates", "mode": "single",
         "condition": "add_condition_ratio_less_or_equal", "params": {"max_ratio": 0.0},
         "severity": "warning",
         "reason": "Dos estaciones con el mismo perfil exacto sugieren un error de agregación."},
        {"id": "deriva_de_perfiles", "deepchecks": "FeatureDrift", "mode": "pair",
         "condition": "add_condition_drift_score_less_than",
         "params": {"allowed_num_features_exceeding_threshold": 4}, "severity": "warning",
         "reason": "Se reporta para interpretar la estabilidad de los grupos entre temporadas."}
      ]
    }
  }
}
