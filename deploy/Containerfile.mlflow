FROM ghcr.io/mlflow/mlflow:v3.17.2@sha256:2cc40b3208991940d824d04f339833a0b69507569012aa5ec545690608602fc0
USER root
RUN mkdir -p /tracking/artifacts && chown -R 10001:10001 /tracking
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp MLFLOW_DISABLE_AGENT_HINT=1
USER 10001:10001
WORKDIR /tracking
EXPOSE 5000
